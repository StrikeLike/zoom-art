---
import type { Work } from '../lib/works';
interface Props { work: Work; class?: string; eager?: boolean; shared?: boolean; sizes?: string; }
const { work, class: className = '', eager = false, shared = false, sizes = '(max-width: 700px) 100vw, 92vw' } = Astro.props;
const [w, h] = work.image.sizes['1280'];
---
<img class={className} src={`${work.image.base}/painting-1280.webp`} srcset={Object.entries(work.image.sizes).map(([size, [width]]) => `${work.image.base}/painting-${size}.webp ${width}w`).join(', ')} sizes={sizes} width={w} height={h} alt={work.image.alt} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} decoding="async" style={shared ? `view-transition-name:art-${work.slug}` : undefined} />
