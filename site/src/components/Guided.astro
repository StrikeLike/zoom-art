---
import imageSizes from "../data/image-sizes.json";
import work from '../data/work.json';
import site from '../data/site.json';
import Painting from './Painting.astro';
const steps = work.slides.slice(1);
---
<section class="guided-section section-space" id="guided" aria-labelledby="guided-heading" data-guided data-dzi={work.image.dzi} data-width={work.image.width} data-height={work.image.height}>
  <div class="wrap section-heading"><div><p class="eyebrow">{site.ui.guidedLabel}</p><h2 id="guided-heading">{site.ui.guidedStory}</h2></div><p>{site.ui.guidedIntro}</p></div>
  <div class="guide-layout wrap">
    <div class="guide-stage">
      <div class="guide-artboard"><Painting class="guide-poster" sizes="(max-width: 760px) 100vw, 65vw" /><div id="guided-canvas" class="zoom-canvas" aria-hidden="true"></div><div class="focus-corners guide-focus" aria-hidden="true"><i></i><i></i><i></i><i></i></div></div>
      <div class="guide-tools"><div><p class="eyebrow">{work.title}</p><span class="guide-progress"><span data-progress>01</span><span class="progress-rule"></span>{String(steps.length).padStart(2,'0')}</span></div><div class="mini-map" role="img" aria-label={site.ui.miniMap}><img src={`${work.image.base}/painting-480.webp`} width="8000" height="5770" alt="" loading="lazy" /><span class="map-window"></span></div></div>
      <div class="guide-step-links"><a class="text-link" href="#explore">{site.ui.explorePainting}<span aria-hidden="true">↓</span></a><a class="text-link" href="#article">{site.ui.readArticle}<span aria-hidden="true">↓</span></a></div>
    </div>
    <div class="guide-narrative">{steps.map((step, index) => <section class="story-step" id={`step-${index+1}`} data-step={index} data-focus={JSON.stringify(step.focus)} aria-labelledby={`step-title-${index}`}>
      <span class="step-number" aria-hidden="true">{String(index+1).padStart(2,'0')}<span>/ {String(steps.length).padStart(2,'0')}</span></span>
      <img class="step-fallback" src={`${work.image.base}/detail-${index+1}.webp`} alt={step.text} loading="lazy" width={imageSizes[`/images/childrens-games/detail-${index+1}.webp` as keyof typeof imageSizes][0]} height={imageSizes[`/images/childrens-games/detail-${index+1}.webp` as keyof typeof imageSizes][1]} />
      <h3 id={`step-title-${index}`} aria-label={step.headline}>{step.headline.split(' ').map((word,i) => <span class="story-word" aria-hidden="true" style={`--word:${i}`}>{word}{' '}</span>)}</h3><p class="story-copy"><span class="sr-only">{step.text}</span>{step.text?.split(' ').map(word => <span class="story-word" aria-hidden="true">{word}{' '}</span>)}</p>
      <a class="step-next" href={index < steps.length-1 ? `#step-${index+2}` : '#explore'}>{index < steps.length-1 ? site.ui.nextDetail : site.ui.explorePainting}<span aria-hidden="true">↓</span></a>
    </section>)}</div>
  </div>
</section>
<script>
  import { initGuided } from '../scripts/viewers';
  initGuided();
</script>
