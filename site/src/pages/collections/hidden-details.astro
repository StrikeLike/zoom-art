---
import Base from '../../layouts/Base.astro';
import Painting from '../../components/Painting.astro';
import Credit from '../../components/Credit.astro';
import Related from '../../components/Related.astro';
import site from '../../data/site.json';
import work from '../../data/work.json';
const page = site.pages.collection;
---
<Base title={`${page.title} | ${site.brand.name}`} description={page.description}>
  <div class="wrap"><header class="page-heading"><p class="eyebrow">{page.eyebrow}</p><h1>{page.title}</h1><p>{page.description}</p></header><section class="collection-feature"><a href={`/works/${work.slug}/`}><Painting eager shared sizes="(max-width:760px) 100vw, 60vw" /></a><div><p class="eyebrow">{page.featuredLabel}</p><h2>{page.featuredTitle}</h2><p>{page.featuredText}</p><a class="button" href={`/works/${work.slug}/`}>{site.ui.beginStory}<span aria-hidden="true">↗</span></a></div></section><Credit /><div class="editorial-layout section-space"><aside>{page.intro}</aside><div class="editorial-prose"><h2>{page.moreTitle}</h2><p>{page.moreText}</p></div></div></div><Related />
</Base>
