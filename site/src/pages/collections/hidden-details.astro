---
import Base from '../../layouts/Base.astro';
import Painting from '../../components/Painting.astro';
import Credit from '../../components/Credit.astro';
import Related from '../../components/Related.astro';
import site from '../../data/site.json';
import { getWork, works } from '../../lib/works';
const page = site.pages.collection;
const first = getWork('the-ambassadors');
---
<Base title={`${page.title} | ${site.brand.name}`} description={page.description} image={`${first.image.base}/painting-1280.webp`} noindex>
  <div class="wrap"><header class="page-heading"><p class="eyebrow">{page.eyebrow}</p><h1>{page.title}</h1><p>{page.description}</p></header><section class="collection-feature"><a href={`/works/${first.slug}/`}><Painting work={first} eager shared sizes="(max-width:760px) 100vw, 60vw" /></a><div><p class="eyebrow">{page.featuredLabel}</p><h2>{first.hook}</h2><p>{first.title}, {first.artist}, {first.year}</p><a class="button" href={`/works/${first.slug}/`}>{site.ui.beginStory}<span aria-hidden="true">↗</span></a></div></section><Credit work={first} /></div>
  <Related works={works.filter(w => w !== first)} heading={page.moreTitle} intro={page.moreText} />
</Base>
